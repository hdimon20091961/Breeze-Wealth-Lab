<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Breeze.Strategies</AssemblyName>
    <RootNamespace>BreezeHoldPosition.Strategies</RootNamespace>
    <Version>0.10.26</Version>
    <WealthLabInstallDir Condition="'$(WealthLabInstallDir)' == ''">C:\Program Files\Quantacula, LLC\WealthLab 8</WealthLabInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The research event-model strategy is validated by tests/EventModel and is not shipped in this DLL. -->
    <Compile Remove="BreezeHoldPositionStrategy_new.cs" />
    <Reference Include="WealthLab.Core">
      <HintPath>$(WealthLabInstallDir)\WealthLab.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
