<wpf:ChildWindow x:Class="BreezeVL.BreezeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpf="clr-namespace:WealthLab.WPF;assembly=WealthLab.WPF"
    xmlns:local="clr-namespace:BreezeVL"
    Background="{DynamicResource BlueBackground}">
    <DockPanel Background="{DynamicResource ContainerBackground}">
        <Grid DockPanel.Dock="Top" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="S&amp;P DataSet:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="SpDataSet" Grid.Column="1" Margin="0,0,12,0" DisplayMemberPath="QualifiedName"/>
            <TextBlock Grid.Column="2" Text="Nasdaq-100 DataSet:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="NasdaqDataSet" Grid.Column="3" Margin="0,0,12,0" DisplayMemberPath="QualifiedName"/>
            <Button x:Name="RefreshButton" Grid.Column="4" Content="Calculate 12 years" Padding="12,4" Click="RefreshClick"/>
            <CheckBox x:Name="ShowSp500Price" Grid.Column="5" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="Show S&amp;P 500 price" IsChecked="True"
                      Checked="ShowSp500PriceChanged" Unchecked="ShowSp500PriceChanged"/>
            <CheckBox x:Name="ShowSp500Candles" Grid.Column="6" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="Candles" IsChecked="False"
                      Checked="ShowSp500CandlesChanged" Unchecked="ShowSp500CandlesChanged"/>
            <CheckBox x:Name="UseLogBreadth" Grid.Column="7" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="Log breadth" IsChecked="False"
                      Checked="UseLogBreadthChanged" Unchecked="UseLogBreadthChanged"/>
            <TextBlock x:Name="StatusText" Grid.Column="8" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Bottom" Margin="8,2,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CursorValuesText" VerticalAlignment="Center"
                           Text="Move the cursor over a chart to inspect all breadth values"
                           TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="−" Width="26" Height="22" Margin="0,0,2,0"
                            ToolTip="Show 50 fewer bars" Click="DecreaseVisibleBarsClick"/>
                    <TextBlock x:Name="VisibleBarsText" Text="500 bars" Width="60"
                               TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="+" Width="26" Height="22" Margin="2,0,6,0"
                            ToolTip="Show 50 more bars" Click="IncreaseVisibleBarsClick"/>
                    <Slider x:Name="HistorySlider" Width="280" Minimum="0" Maximum="0"
                            VerticalAlignment="Center" IsMoveToPointEnabled="True"
                            ValueChanged="HistorySliderValueChanged"/>
                    <TextBlock x:Name="VisibleRangeText" Width="175" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
            <TabControl x:Name="BreadthTabs" PreviewMouseWheel="ChartsPreviewMouseWheel"
                        Margin="4,0,4,0" SelectedIndex="0">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Width="130" TextAlignment="Center"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabItem Header="Overview">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <local:BreadthChart x:Name="Sp50Chart"/>
                        <local:BreadthChart x:Name="Sp100Chart" Grid.Column="1"/>
                        <local:BreadthChart x:Name="Sp200Chart" Grid.Row="1"/>
                        <local:BreadthChart x:Name="Nasdaq100Chart" Grid.Row="1" Grid.Column="1"/>
                    </Grid>
                </TabItem>
                <TabItem Header="S&amp;P SMA(50)">
                    <local:BreadthChart x:Name="Sp50DetailChart"/>
                </TabItem>
                <TabItem Header="S&amp;P SMA(100)">
                    <local:BreadthChart x:Name="Sp100DetailChart"/>
                </TabItem>
                <TabItem Header="S&amp;P SMA(200)">
                    <local:BreadthChart x:Name="Sp200DetailChart"/>
                </TabItem>
                <TabItem Header="Nasdaq 100 SMA(100)">
                    <local:BreadthChart x:Name="Nasdaq100DetailChart"/>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</wpf:ChildWindow>
