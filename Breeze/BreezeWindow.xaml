<wpf:ChildWindow x:Class="BreezeVL.BreezeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpf="clr-namespace:WealthLab.WPF;assembly=WealthLab.WPF"
    xmlns:local="clr-namespace:BreezeVL"
    Background="{DynamicResource BlueBackground}">
    <wpf:ChildWindow.Resources>
        <Style x:Key="ScoreModelSelectorStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Width="15" Height="15" BorderBrush="#7C8894" BorderThickness="1" Background="White" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 2,6 L 5,9 L 11,2" Stroke="#22623D" StrokeThickness="2"
                                      Visibility="Hidden" Margin="1"/>
                            </Border>
                            <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="MarketSetupCompactToggleTemplate">
            <Line X1="0" X2="8" Y1="6" Y2="6" Width="8" Height="12"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"
                  StrokeThickness="2.2">
                <Line.Style>
                    <Style TargetType="Line">
                        <Setter Property="Opacity" Value="0.38"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=CheckBox}}" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Line.Style>
            </Line>
        </DataTemplate>
        <DataTemplate x:Key="SentimentIndicatorToggleTemplate">
            <DockPanel VerticalAlignment="Center">
                <Line X1="0" X2="9" Y1="6" Y2="6" Width="9" Height="12"
                      DockPanel.Dock="Left"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"
                      StrokeThickness="2.2" VerticalAlignment="Center">
                    <Line.Style>
                        <Style TargetType="Line">
                            <Setter Property="Opacity" Value="0.38"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=CheckBox}}"
                                             Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Line.Style>
                </Line>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#202326" Margin="2,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=CheckBox}}"
                                             Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </DataTemplate>
        <Style x:Key="SentimentIndicatorToggleStyle" TargetType="CheckBox">
            <Setter Property="ContentTemplate" Value="{StaticResource SentimentIndicatorToggleTemplate}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
        </Style>
    </wpf:ChildWindow.Resources>
    <DockPanel Background="{DynamicResource ContainerBackground}">
        <Grid DockPanel.Dock="Top" Margin="8,6" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SpDataSet" Grid.Column="0" Visibility="Collapsed" DisplayMemberPath="QualifiedName"/>
            <ComboBox x:Name="NasdaqDataSet" Grid.Column="1" Visibility="Collapsed" DisplayMemberPath="QualifiedName"/>
            <RadioButton x:Name="Rules1Selector" Grid.Column="2" Content="Rules1" IsChecked="True"
                         Style="{StaticResource ScoreModelSelectorStyle}" Checked="ScoreModelChanged"/>
            <RadioButton x:Name="Rules2Selector" Grid.Column="3" Content="Rules2"
                         Style="{StaticResource ScoreModelSelectorStyle}" Checked="ScoreModelChanged"/>
            <Button x:Name="RefreshButton" Grid.Column="4" Content="Recalculate" MinWidth="108" Padding="14,4"
                    Background="#BFE8C5" Foreground="#173B20" FontWeight="SemiBold" Click="RefreshClick"/>
            <CheckBox x:Name="ShowSp500Price" Grid.Column="5" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="Show S&amp;P" IsChecked="True"
                      Checked="ShowSp500PriceChanged" Unchecked="ShowSp500PriceChanged"/>
            <CheckBox x:Name="ShowSp500Candles" Grid.Column="6" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="Candles" IsChecked="True"
                      Checked="ShowSp500CandlesChanged" Unchecked="ShowSp500CandlesChanged"/>
            <CheckBox x:Name="FullOhlc" Grid.Column="8" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="OHLC" IsChecked="False"
                      Checked="FullOhlcChanged" Unchecked="FullOhlcChanged"/>
            <CheckBox x:Name="ShowFuzzyZones" Grid.Column="9" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="Fuzzy zones" IsChecked="True"
                      Checked="ShowFuzzyZonesChanged" Unchecked="ShowFuzzyZonesChanged"/>
            <Button Grid.Column="10" Margin="12,0,0,0" Padding="9,3" Content="? Help" Click="HelpClick"/>
            <TextBlock x:Name="StatusText" Grid.Column="11" Margin="12,0,0,0" VerticalAlignment="Center"
                       MinWidth="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="60000"/>
        </Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Bottom" Margin="8,2,8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CursorValuesText" Grid.ColumnSpan="2" VerticalAlignment="Center"
                           Text="Move the cursor over a chart to inspect all breadth values"
                           TextWrapping="NoWrap" Margin="0,0,6,2"/>
                <TextBlock x:Name="CursorIndicatorsText" Grid.Row="1" VerticalAlignment="Center"
                           Text="EMA and MyRSI_rep + AGC values will appear here"
                           TextWrapping="NoWrap" Margin="0,1,12,0"/>
                <TextBlock x:Name="TradingCursorValuesText" Grid.Row="1" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" Margin="0,1,12,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel x:Name="TradingPerformancePeriodControls" Orientation="Horizontal"
                                Visibility="Collapsed" Margin="0,0,8,0">
                        <RepeatButton Content="−" Delay="350" Interval="100" Width="26" Height="22"
                                      Background="#C2EDCB" BorderBrush="#86DC97" Margin="0,0,2,0"
                                      ToolTip="Reduce the recent-performance period by 10 trading bars"
                                      Click="DecreaseTradingPerformanceBarsClick"/>
                        <TextBlock x:Name="TradingPerformanceBarsText" Text="150" Width="42"
                                   Background="#E2F6E6" TextAlignment="Center" VerticalAlignment="Center"
                                   ToolTip="Recent-performance period in trading bars"/>
                        <RepeatButton Content="+" Delay="350" Interval="100" Width="26" Height="22"
                                      Background="#C2EDCB" BorderBrush="#86DC97" Margin="2,0,0,0"
                                      ToolTip="Increase the recent-performance period by 10 trading bars"
                                      Click="IncreaseTradingPerformanceBarsClick"/>
                    </StackPanel>
                    <RepeatButton Content="−" Delay="350" Interval="100" Width="26" Height="22" Margin="0,0,2,0"
                            ToolTip="Show 20 fewer bars" Click="DecreaseVisibleBarsClick"/>
                    <TextBlock x:Name="VisibleBarsText" Text="200 bars" Width="60"
                               TextAlignment="Center" VerticalAlignment="Center"/>
                    <RepeatButton Content="+" Delay="350" Interval="100" Width="26" Height="22" Margin="2,0,6,0"
                            ToolTip="Show 20 more bars" Click="IncreaseVisibleBarsClick"/>
                    <Slider x:Name="HistorySlider" Width="280" Minimum="0" Maximum="0"
                            VerticalAlignment="Center" IsMoveToPointEnabled="True"
                            ValueChanged="HistorySliderValueChanged"/>
                    <TextBlock x:Name="VisibleRangeText" Width="175" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
            <TabControl x:Name="BreadthTabs" PreviewMouseWheel="ChartsPreviewMouseWheel"
                        PreviewMouseLeftButtonDown="ChartsMouseLeftButtonDown"
                        PreviewMouseMove="ChartsMouseMove"
                        PreviewMouseLeftButtonUp="ChartsMouseLeftButtonUp"
                        Margin="4,0,4,0" SelectedIndex="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem x:Name="OverviewTab">
                    <TabItem.Header>
                        <TextBlock Text="All breadths" Width="112" TextAlignment="Center"/>
                    </TabItem.Header>
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="5,4,5,1">
                            <TextBlock Text="Breadth view:" VerticalAlignment="Center"
                                       Margin="0,0,9,0" Foreground="#4B4E52"/>
                            <CheckBox x:Name="OverviewFull" Content="Full" IsChecked="True"
                                      FontWeight="SemiBold" Margin="0,0,15,0"
                                      Checked="OverviewBreadthChanged" Unchecked="OverviewBreadthChanged"/>
                            <CheckBox x:Name="OverviewSp50" Content="S&amp;P 500 SMA(50)" IsChecked="False"
                                      Foreground="#1976D2" Margin="0,0,13,0"
                                      Checked="OverviewBreadthChanged" Unchecked="OverviewBreadthChanged"/>
                            <CheckBox x:Name="OverviewSp100" Content="S&amp;P 500 SMA(100)" IsChecked="False"
                                      Foreground="#2E7D32" Margin="0,0,13,0"
                                      Checked="OverviewBreadthChanged" Unchecked="OverviewBreadthChanged"/>
                            <CheckBox x:Name="OverviewSp200" Content="S&amp;P 500 SMA(200)" IsChecked="False"
                                      Foreground="#8E44AD" Margin="0,0,13,0"
                                      Checked="OverviewBreadthChanged" Unchecked="OverviewBreadthChanged"/>
                            <CheckBox x:Name="OverviewNasdaq100" Content="Nasdaq 100 SMA(100)" IsChecked="False"
                                      Foreground="#E67E22" Margin="0,0,15,0"
                                      Checked="OverviewBreadthChanged" Unchecked="OverviewBreadthChanged"/>
                            <CheckBox x:Name="OverviewLogBreadth" Content="Log breadth" IsChecked="False"
                                      Margin="0,0,13,0"
                                      Checked="OverviewLogBreadthChanged" Unchecked="OverviewLogBreadthChanged"/>
                            <CheckBox x:Name="OverviewAtrp" Content="ATRP(1)" IsChecked="True"
                                      Foreground="#6750A4" Margin="0,0,13,0"
                                      Checked="OverviewIndicatorChanged" Unchecked="OverviewIndicatorChanged"/>
                            <CheckBox x:Name="OverviewEma" Content="EMA 20/50/100/200" IsChecked="False"
                                      Checked="OverviewIndicatorChanged" Unchecked="OverviewIndicatorChanged"/>
                        </StackPanel>
                        <Grid x:Name="OverviewFullGrid" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="OverviewFullTopRow" Height="*" MinHeight="90"/>
                                <RowDefinition Height="11"/>
                                <RowDefinition x:Name="OverviewFullBottomRow" Height="*" MinHeight="90"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="OverviewFullLeftColumn" Width="*" MinWidth="180"/>
                                <ColumnDefinition Width="11"/>
                                <ColumnDefinition x:Name="OverviewFullRightColumn" Width="*" MinWidth="180"/>
                            </Grid.ColumnDefinitions>
                            <local:BreadthChart x:Name="Sp50Chart"/>
                            <local:BreadthChart x:Name="Sp100Chart" Grid.Column="2"/>
                            <local:BreadthChart x:Name="Sp200Chart" Grid.Row="2"/>
                            <local:BreadthChart x:Name="Nasdaq100Chart" Grid.Row="2" Grid.Column="2"/>
                            <GridSplitter x:Name="OverviewFullHorizontalSplitter" Grid.Row="1" Grid.ColumnSpan="3"
                                          Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          Background="#D7CFBB" DragCompleted="LayoutSplitterDragCompleted"/>
                            <GridSplitter x:Name="OverviewFullVerticalSplitter" Grid.Column="1" Grid.RowSpan="3"
                                          Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                          Background="#D7CFBB" DragCompleted="LayoutSplitterDragCompleted"/>
                        </Grid>
                        <Grid x:Name="OverviewIndividualGrid" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="OverviewCombinedRow" Height="2*"/>
                                <RowDefinition x:Name="OverviewAtrpSplitterRow" Height="5"/>
                                <RowDefinition x:Name="OverviewAtrpRow" Height="*"/>
                            </Grid.RowDefinitions>
                            <local:BreadthChart x:Name="OverviewCombinedChart" Grid.Row="0"/>
                            <GridSplitter x:Name="OverviewAtrpSplitter" Grid.Row="1" Height="5"
                                          HorizontalAlignment="Stretch" Background="#D7CFBB"
                                          DragCompleted="LayoutSplitterDragCompleted"/>
                            <local:AtrpChart x:Name="OverviewAtrpChart" Grid.Row="2"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="TitanicTab">
                    <TabItem.Header>
                        <TextBlock Text="Titanic" Width="112" TextAlignment="Center"/>
                    </TabItem.Header>
                    <DockPanel Background="White">
                        <StackPanel DockPanel.Dock="Top" Background="White" Orientation="Horizontal" HorizontalAlignment="Center" Margin="6,4,6,0">
                            <CheckBox x:Name="TitanicShowActive" Content="Titanic Active" IsChecked="True"
                                      Foreground="#3199C8" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"
                                      Checked="TitanicLayerVisibilityChanged" Unchecked="TitanicLayerVisibilityChanged"/>
                            <CheckBox x:Name="TitanicShowPersistent" Content="Persistent" IsChecked="True"
                                      Foreground="#218A57" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"
                                      Checked="TitanicLayerVisibilityChanged" Unchecked="TitanicLayerVisibilityChanged"/>
                            <CheckBox x:Name="TitanicShowHold" Content="Оценка" IsChecked="True"
                                      Margin="14,0,0,0" VerticalAlignment="Center"
                                      Checked="HoldVisibilityChanged" Unchecked="HoldVisibilityChanged"/>
                            <CheckBox x:Name="TitanicShowNewHigh" Content="New High" IsChecked="True"
                                      Foreground="#239152" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"
                                      Checked="TitanicLayerVisibilityChanged" Unchecked="TitanicLayerVisibilityChanged"/>
                            <CheckBox x:Name="TitanicShowNewLow" Content="New Low" IsChecked="True"
                                      Foreground="#C43737" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"
                                      Checked="TitanicLayerVisibilityChanged" Unchecked="TitanicLayerVisibilityChanged"/>
                            <CheckBox x:Name="TitanicShowValue" Content="Titanic value" IsChecked="True"
                                      Foreground="#2958B0" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"
                                      Checked="TitanicLayerVisibilityChanged" Unchecked="TitanicLayerVisibilityChanged"/>
                        </StackPanel>
                        <local:TitanicChart x:Name="TitanicChart"/>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="SentimentTab">
                    <TabItem.Header>
                        <TextBlock Text="Sentiment" Width="112" TextAlignment="Center"/>
                    </TabItem.Header>
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" BorderBrush="#D7CFBB"
                                BorderThickness="0,0,0,1" Padding="8,4,8,4">
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <CheckBox x:Name="SentimentCnnFearGreed" Content="CNN Fear Greed" IsChecked="True"
                                          Foreground="#235C9E" Style="{StaticResource SentimentIndicatorToggleStyle}"
                                          ToolTip="CNN Fear Greed — normalized to −1…+1"
                                          Checked="SentimentOptionsChanged" Unchecked="SentimentOptionsChanged"/>
                                <CheckBox x:Name="SentimentRiskMeasure" Content="Risk Measure" IsChecked="False"
                                          Foreground="#C43636" Style="{StaticResource SentimentIndicatorToggleStyle}"
                                          ToolTip="Risk Measure — normalized to −1…+1"
                                          Checked="SentimentOptionsChanged" Unchecked="SentimentOptionsChanged"/>
                                <CheckBox x:Name="SentimentPanicEuphoria" Content="Panic Euphoria" IsChecked="False"
                                          Foreground="#7E4BAE" Style="{StaticResource SentimentIndicatorToggleStyle}"
                                          ToolTip="Panic Euphoria — normalized to −1…+1"
                                          Checked="SentimentOptionsChanged" Unchecked="SentimentOptionsChanged"/>
                                <CheckBox x:Name="SentimentArsi" Content="ARSI" IsChecked="False"
                                          Foreground="#17897E" Style="{StaticResource SentimentIndicatorToggleStyle}"
                                          ToolTip="ARSI(Close, 14) — normalized as (ARSI − 50) / 50"
                                          Checked="SentimentOptionsChanged" Unchecked="SentimentOptionsChanged"/>
                                <CheckBox x:Name="SentimentMyRsi" Content="MyRSI 14,8" IsChecked="False"
                                          Foreground="#2D4E70" Style="{StaticResource SentimentIndicatorToggleStyle}"
                                          Checked="SentimentOptionsChanged" Unchecked="SentimentOptionsChanged"/>
                                <CheckBox x:Name="SentimentTrendScore" Content="Trend Score" IsChecked="False"
                                          Foreground="#D67E16" Style="{StaticResource SentimentIndicatorToggleStyle}"
                                          ToolTip="Trend Score"
                                          Checked="SentimentOptionsChanged" Unchecked="SentimentOptionsChanged"/>
                                <CheckBox x:Name="SentimentHurst" Content="Hurst" IsChecked="False"
                                          Foreground="#626A74" Style="{StaticResource SentimentIndicatorToggleStyle}"
                                          ToolTip="Hurst"
                                          Checked="SentimentOptionsChanged" Unchecked="SentimentOptionsChanged"/>
                                <CheckBox x:Name="SentimentCmf" Content="CMF" IsChecked="False"
                                          Foreground="#228B45" Style="{StaticResource SentimentIndicatorToggleStyle}"
                                          ToolTip="CMF — Chaikin Money Flow"
                                          Checked="SentimentOptionsChanged" Unchecked="SentimentOptionsChanged"/>
                                <CheckBox x:Name="SentimentDecibel" Content="Decibel" IsChecked="False"
                                          Foreground="#B3428A" Style="{StaticResource SentimentIndicatorToggleStyle}"
                                          ToolTip="Decibel"
                                          Checked="SentimentOptionsChanged" Unchecked="SentimentOptionsChanged"/>
                                <CheckBox x:Name="SentimentJocker" Content="Jocker" IsChecked="False"
                                          Foreground="#7A582C" Style="{StaticResource SentimentIndicatorToggleStyle}"
                                          ToolTip="Jocker — ZZ1: EMA 3, High/Low 65, directional mode"
                                          Checked="SentimentOptionsChanged" Unchecked="SentimentOptionsChanged"/>
                                <CheckBox x:Name="SentimentMarketBreadth" Content="Market Breadth" IsChecked="False"
                                          Foreground="#2B7B92" Style="{StaticResource SentimentIndicatorToggleStyle}"
                                          ToolTip="Market Breadth"
                                          Checked="SentimentOptionsChanged" Unchecked="SentimentOptionsChanged"/>
                                <CheckBox x:Name="SentimentDumbMoney" Content="Dumb Money" IsChecked="False"
                                          Foreground="#C2661C" Style="{StaticResource SentimentIndicatorToggleStyle}"
                                          ToolTip="Dumb Money — normalized from 0…1 to −1…+1"
                                          Checked="SentimentOptionsChanged" Unchecked="SentimentOptionsChanged"/>
                                <CheckBox x:Name="SentimentSmartMoney" Content="Smart Money" IsChecked="False"
                                          Foreground="#1B7E41" Style="{StaticResource SentimentIndicatorToggleStyle}"
                                          ToolTip="Smart Money — normalized from 0…1 to −1…+1"
                                          Checked="SentimentOptionsChanged" Unchecked="SentimentOptionsChanged"/>
                                <CheckBox x:Name="SentimentEma" Content="EMA 20/50/100/200" IsChecked="False"
                                          Foreground="#4B4E52"
                                          Checked="SentimentOptionsChanged" Unchecked="SentimentOptionsChanged"/>
                            </WrapPanel>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="SentimentTopRow" Height="2*" MinHeight="110"/>
                                <RowDefinition Height="11"/>
                                <RowDefinition x:Name="SentimentBottomRow" Height="*" MinHeight="90"/>
                            </Grid.RowDefinitions>
                            <local:BreadthChart x:Name="SentimentSpChart" Grid.Row="0"/>
                            <GridSplitter x:Name="SentimentSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          Background="#D7CFBB" DragCompleted="LayoutSplitterDragCompleted"/>
                            <local:SentimentChart x:Name="SentimentIndicatorChart" Grid.Row="2"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="FuzzyTab">
                    <TabItem.Header>
                        <TextBlock Text="Fuzzy map" Width="112" TextAlignment="Center"/>
                    </TabItem.Header>
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FuzzyAnalysisColumn" Width="1*" MinWidth="285"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition x:Name="FuzzyChartColumn" Width="3*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Row="0" Grid.ColumnSpan="3" Background="White" HorizontalAlignment="Stretch" Margin="6,4,6,0">
                                <TextBlock Text="Phase:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Border Width="14" Height="14" Background="#188040" Margin="8,0,3,0"/>
                                <TextBlock Text="Strong buy" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#7EBE76" Margin="14,0,3,0"/>
                                <TextBlock Text="Buy" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="White" BorderBrush="#CFC4AB" BorderThickness="1" Margin="14,0,3,0"/>
                                <TextBlock Text="Neutral" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#E68430" Margin="14,0,3,0"/>
                                <TextBlock Text="Sell" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#C43737" Margin="14,0,3,0"/>
                                <TextBlock Text="Strong sell" VerticalAlignment="Center"/>
                                <TextBlock Text="   VIX curve:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Border Width="14" Height="14" Background="#188040" Margin="8,0,3,0"/>
                                <TextBlock Text="STR. contango" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#7EBE76" Margin="8,0,3,0"/>
                                <TextBlock Text="Contango" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#E89737" Margin="8,0,3,0"/>
                                <TextBlock Text="Mixed" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#E78B78" Margin="8,0,3,0"/>
                                <TextBlock Text="Backward" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#C43737" Margin="8,0,3,0"/>
                                <TextBlock Text="STR. backward" VerticalAlignment="Center"/>
                                <TextBlock Text="   SVXY:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Border Width="14" Height="14" Background="#268BC4" Margin="8,0,3,0"/>
                                <TextBlock Text="Strong buy" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#89CBE8" Margin="8,0,3,0"/>
                                <TextBlock Text="Buy / hold" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#D3EEF8" Margin="8,0,3,0"/>
                                <TextBlock Text="Extended hold" VerticalAlignment="Center"/>
                                <CheckBox x:Name="FuzzyShowHold" Content="Оценки" IsChecked="True"
                                          Margin="18,0,0,0" VerticalAlignment="Center"
                                          Checked="HoldVisibilityChanged" Unchecked="HoldVisibilityChanged"/>
                        </WrapPanel>
                        <Border x:Name="FuzzyAnalysisPanel" Grid.Row="1" Grid.Column="0" Margin="5,4,2,4" Padding="12,10"
                                Background="#F6F9FC" BorderBrush="#C7D3DF" BorderThickness="1"
                                CornerRadius="4">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="CopyMarketStateButton" Grid.Column="0"
                                            Width="25" Height="24" Margin="0,0,7,0" Padding="0"
                                            Background="Transparent" BorderBrush="#AAB8C5"
                                            ToolTip="Скопировать весь отчёт о состоянии рынка"
                                            Click="CopyMarketStateClick">
