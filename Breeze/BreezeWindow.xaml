                                            <CheckBox x:Name="MarketSetupHurst" Content="Hurst" Foreground="#626A74"
                                                      Style="{StaticResource SentimentIndicatorToggleStyle}" Checked="MarketSetupOptionsChanged" Unchecked="MarketSetupOptionsChanged"/>
                                            <CheckBox x:Name="MarketSetupCmf" Content="CMF" Foreground="#228B45"
                                                      Style="{StaticResource SentimentIndicatorToggleStyle}" Checked="MarketSetupOptionsChanged" Unchecked="MarketSetupOptionsChanged"/>
                                            <CheckBox x:Name="MarketSetupDecibel" Content="Decibel" Foreground="#B3428A"
                                                      Style="{StaticResource SentimentIndicatorToggleStyle}" Checked="MarketSetupOptionsChanged" Unchecked="MarketSetupOptionsChanged"/>
                                            <CheckBox x:Name="MarketSetupJocker" Content="Jocker" Foreground="#7A582C" ToolTip="Параметры ZZ1/ZZ2: суммы новых максимумов и минимумов Nasdaq за 65 баров; (максимумы − минимумы) / (максимумы + минимумы); EMA(3)."
                                                      Style="{StaticResource SentimentIndicatorToggleStyle}" Checked="MarketSetupOptionsChanged" Unchecked="MarketSetupOptionsChanged"/>
                                            <CheckBox x:Name="MarketSetupMarketBreadth" Content="Market Breadth" Foreground="#2B7B92" ToolTip="Параметры ZZ1/ZZ2: доля SPY, XLV, XLU, XLE и XLP выше VWMA(64); EMA(1); 0,01 × (значение − 50)."
                                                      Style="{StaticResource SentimentIndicatorToggleStyle}" Checked="MarketSetupOptionsChanged" Unchecked="MarketSetupOptionsChanged"/>
                                            <CheckBox x:Name="MarketSetupDumbMoney" Content="Dumb Money" Foreground="#C2661C"
                                                      Style="{StaticResource SentimentIndicatorToggleStyle}" Checked="MarketSetupOptionsChanged" Unchecked="MarketSetupOptionsChanged"/>
                                            <CheckBox x:Name="MarketSetupSmartMoney" Content="Smart Money" Foreground="#1B7E41"
                                                      Style="{StaticResource SentimentIndicatorToggleStyle}" Checked="MarketSetupOptionsChanged" Unchecked="MarketSetupOptionsChanged"/>
                                            <Separator Margin="0,6"/>
                                            <CheckBox x:Name="MarketSetupEma" Content="EMA 20/50/100/200"
                                                      Checked="MarketSetupOptionsChanged" Unchecked="MarketSetupOptionsChanged"/>
                                            <CheckBox x:Name="MarketSetupSp50" Content="S&amp;P 500 SMA50" IsChecked="False" Foreground="#1976D2"
                                                      ToolTip="Широта S&amp;P 500: доля компонентов выше SMA(50), проценты, правая ось нижнего графика."
                                                      Style="{StaticResource SentimentIndicatorToggleStyle}" Checked="MarketSetupOptionsChanged" Unchecked="MarketSetupOptionsChanged"/>
                                            <CheckBox x:Name="MarketSetupSp100" Content="S&amp;P 500 SMA100" IsChecked="False" Foreground="#2E7D32"
                                                      ToolTip="Широта S&amp;P 500: доля компонентов выше SMA(100), проценты, правая ось нижнего графика."
                                                      Style="{StaticResource SentimentIndicatorToggleStyle}" Checked="MarketSetupOptionsChanged" Unchecked="MarketSetupOptionsChanged"/>
                                            <CheckBox x:Name="MarketSetupSp200" Content="S&amp;P 500 SMA200" IsChecked="False" Foreground="#8E44AD"
                                                      ToolTip="Широта S&amp;P 500: доля компонентов выше SMA(200), проценты, правая ось нижнего графика."
                                                      Style="{StaticResource SentimentIndicatorToggleStyle}" Checked="MarketSetupOptionsChanged" Unchecked="MarketSetupOptionsChanged"/>
                                            <CheckBox x:Name="MarketSetupNasdaq100" Content="Nasdaq-100 SMA100" IsChecked="False" Foreground="#E67E22"
                                                      ToolTip="Широта Nasdaq-100: доля компонентов выше SMA(100), проценты, правая ось нижнего графика."
                                                      Style="{StaticResource SentimentIndicatorToggleStyle}" Checked="MarketSetupOptionsChanged" Unchecked="MarketSetupOptionsChanged"/>
                                            <CheckBox x:Name="MarketSetupAtrp" Content="ATRP(1)" IsChecked="False" Foreground="#6750A4"
                                                      ToolTip="Однодневный истинный диапазон в процентах Close. Отдельная синхронная панель."
                                                      Style="{StaticResource SentimentIndicatorToggleStyle}" Checked="MarketSetupOptionsChanged" Unchecked="MarketSetupOptionsChanged"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <GridSplitter x:Name="MarketSetupIndicatorsSplitter" Grid.Column="1" Width="5"
                                          HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns"
                                          ResizeBehavior="PreviousAndNext" Background="#D7CFBB" DragCompleted="LayoutSplitterDragCompleted"/>
                            <Border x:Name="MarketSetupRulesPanel" Grid.Column="2" Background="White" BorderBrush="#D7CFBB" BorderThickness="1" Padding="2"
                                    ClipToBounds="True" SizeChanged="MarketSetupColumnSizeChanged">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="3,3,3,6">
                                      <WrapPanel>
                                        <TextBlock Text="Правила" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#25303D" Margin="0,0,8,0"/>
                                        <CheckBox x:Name="MarketSetupActiveRules" Content="Активные" IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Показывать правила с ненулевым весом хотя бы в одном профиле Breeze: Soft, Standard или Hard."
                                                  Checked="MarketSetupActiveRulesChanged" Unchecked="MarketSetupActiveRulesChanged"/>
                                      </WrapPanel>
                                      <TextBlock x:Name="MarketSetupCatalogSummary" FontSize="10" TextWrapping="Wrap"
                                                 Foreground="#626970" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TreeView x:Name="MarketSetupRuleTree" Background="White"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              SelectedItemChanged="MarketSetupRuleSelected"/>
                                </DockPanel>
                            </Border>

                            <GridSplitter x:Name="MarketSetupRulesSplitter" Grid.Column="3" Width="5"
                                          HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns"
                                          ResizeBehavior="PreviousAndNext" Background="#D7CFBB" DragCompleted="LayoutSplitterDragCompleted"/>
                            <Border Grid.Column="4" Background="#F6F9FC" BorderBrush="#C7D3DF" BorderThickness="1" Padding="8" ClipToBounds="True">
                                <DockPanel>
                                    <TextBlock x:Name="MarketSetupRuleTitle" DockPanel.Dock="Top" Text="Market setup"
                                               FontSize="15" FontWeight="SemiBold" Foreground="#25303D" Margin="0,0,0,7"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock x:Name="MarketSetupRuleDescription" Text="Выберите правило в дереве."
                                                   TextWrapping="Wrap" FontSize="12.5" LineHeight="16" Foreground="#303840"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <GridSplitter x:Name="MarketSetupVerticalSplitter" Grid.Column="1" Width="5"
                                      HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                      Background="#D7CFBB" DragCompleted="LayoutSplitterDragCompleted"/>

                        <Grid x:Name="MarketSetupChartGrid" Grid.Column="2" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="MarketSetupTopRow" Height="2*" MinHeight="110"/>
                                <RowDefinition Height="11"/>
                                <RowDefinition x:Name="MarketSetupBottomRow" Height="*" MinHeight="90"/>
                            </Grid.RowDefinitions>
                            <local:BreadthChart x:Name="MarketSetupSpChart" Grid.Row="0"/>
                            <GridSplitter x:Name="MarketSetupHorizontalSplitter" Grid.Row="1" Height="5"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#D7CFBB"
                                          DragCompleted="LayoutSplitterDragCompleted"/>
                            <Grid x:Name="MarketSetupLowerGrid" Grid.Row="2" Background="White">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="MarketSetupIndicatorRow" Height="*" MinHeight="90"/>
                                    <RowDefinition x:Name="MarketSetupAtrpSplitterRow" Height="0"/>
                                    <RowDefinition x:Name="MarketSetupAtrpRow" Height="0"/>
                                </Grid.RowDefinitions>
                                <local:SentimentChart x:Name="MarketSetupIndicatorChart" Grid.Row="0"/>
                                <GridSplitter x:Name="MarketSetupAtrpSplitter" Grid.Row="1" Height="5" Visibility="Collapsed"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#D7CFBB"
                                              DragCompleted="LayoutSplitterDragCompleted"/>
                                <local:AtrpChart x:Name="MarketSetupAtrpChart" Grid.Row="2" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</wpf:ChildWindow>
