<wpf:ChildWindow x:Class="BreezeVL.BreezeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpf="clr-namespace:WealthLab.WPF;assembly=WealthLab.WPF"
    xmlns:local="clr-namespace:BreezeVL"
    Background="{DynamicResource BlueBackground}">
    <DockPanel Background="{DynamicResource ContainerBackground}">
        <Grid DockPanel.Dock="Top" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="S&amp;P DataSet:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="SpDataSet" Grid.Column="1" Margin="0,0,12,0" DisplayMemberPath="QualifiedName"/>
            <TextBlock Grid.Column="2" Text="Nasdaq-100 DataSet:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="NasdaqDataSet" Grid.Column="3" Margin="0,0,12,0" DisplayMemberPath="QualifiedName"/>
            <Button x:Name="RefreshButton" Grid.Column="4" Content="Recalculate" MinWidth="108" Padding="14,4"
                    Background="#BFE8C5" Foreground="#173B20" FontWeight="SemiBold" Click="RefreshClick"/>
            <CheckBox x:Name="ShowSp500Price" Grid.Column="5" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="Show S&amp;P" IsChecked="True"
                      Checked="ShowSp500PriceChanged" Unchecked="ShowSp500PriceChanged"/>
            <CheckBox x:Name="ShowSp500Candles" Grid.Column="6" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="Candles" IsChecked="True"
                      Checked="ShowSp500CandlesChanged" Unchecked="ShowSp500CandlesChanged"/>
            <CheckBox x:Name="FullOhlc" Grid.Column="8" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="OHLC" IsChecked="False"
                      Checked="FullOhlcChanged" Unchecked="FullOhlcChanged"/>
            <CheckBox x:Name="ShowFuzzyZones" Grid.Column="9" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="Fuzzy zones" IsChecked="True"
                      Checked="ShowFuzzyZonesChanged" Unchecked="ShowFuzzyZonesChanged"/>
            <Button Grid.Column="10" Margin="12,0,0,0" Padding="9,3" Content="? Help" Click="HelpClick"/>
            <TextBlock x:Name="StatusText" Grid.Column="11" Margin="12,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="60000"/>
        </Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Bottom" Margin="8,2,8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CursorValuesText" Grid.ColumnSpan="2" VerticalAlignment="Center"
                           Text="Move the cursor over a chart to inspect all breadth values"
                           TextWrapping="NoWrap" Margin="0,0,6,2"/>
                <TextBlock x:Name="CursorIndicatorsText" Grid.Row="1" VerticalAlignment="Center"
                           Text="EMA and MyRSI_rep + AGC values will appear here"
                           TextWrapping="NoWrap" Margin="0,1,12,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="−" Width="26" Height="22" Margin="0,0,2,0"
                            ToolTip="Show 20 fewer bars" Click="DecreaseVisibleBarsClick"/>
                    <TextBlock x:Name="VisibleBarsText" Text="200 bars" Width="60"
                               TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="+" Width="26" Height="22" Margin="2,0,6,0"
                            ToolTip="Show 20 more bars" Click="IncreaseVisibleBarsClick"/>
                    <Slider x:Name="HistorySlider" Width="280" Minimum="0" Maximum="0"
                            VerticalAlignment="Center" IsMoveToPointEnabled="True"
                            ValueChanged="HistorySliderValueChanged"/>
                    <TextBlock x:Name="VisibleRangeText" Width="175" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
            <TabControl x:Name="BreadthTabs" PreviewMouseWheel="ChartsPreviewMouseWheel"
                        PreviewMouseLeftButtonDown="ChartsMouseLeftButtonDown"
                        PreviewMouseMove="ChartsMouseMove"
                        PreviewMouseLeftButtonUp="ChartsMouseLeftButtonUp"
                        Margin="4,0,4,0" SelectedIndex="0">
                <TabItem x:Name="OverviewTab">
                    <TabItem.Header>
                        <TextBlock Text="All breadths" Width="160" TextAlignment="Center"/>
                    </TabItem.Header>
                    <Grid Background="#FFFCF4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="5,4,5,1">
                            <TextBlock Text="Breadth view:" VerticalAlignment="Center"
                                       Margin="0,0,9,0" Foreground="#4B4E52"/>
                            <CheckBox x:Name="OverviewFull" Content="Full" IsChecked="True"
                                      FontWeight="SemiBold" Margin="0,0,15,0"
                                      Checked="OverviewBreadthChanged" Unchecked="OverviewBreadthChanged"/>
                            <CheckBox x:Name="OverviewSp50" Content="S&amp;P 500 SMA(50)" IsChecked="False"
                                      Foreground="#1976D2" Margin="0,0,13,0"
                                      Checked="OverviewBreadthChanged" Unchecked="OverviewBreadthChanged"/>
                            <CheckBox x:Name="OverviewSp100" Content="S&amp;P 500 SMA(100)" IsChecked="False"
                                      Foreground="#2E7D32" Margin="0,0,13,0"
                                      Checked="OverviewBreadthChanged" Unchecked="OverviewBreadthChanged"/>
                            <CheckBox x:Name="OverviewSp200" Content="S&amp;P 500 SMA(200)" IsChecked="False"
                                      Foreground="#8E44AD" Margin="0,0,13,0"
                                      Checked="OverviewBreadthChanged" Unchecked="OverviewBreadthChanged"/>
                            <CheckBox x:Name="OverviewNasdaq100" Content="Nasdaq 100 SMA(100)" IsChecked="False"
                                      Foreground="#E67E22" Margin="0,0,15,0"
                                      Checked="OverviewBreadthChanged" Unchecked="OverviewBreadthChanged"/>
                            <CheckBox x:Name="OverviewLogBreadth" Content="Log breadth" IsChecked="False"
                                      Margin="0,0,13,0"
                                      Checked="OverviewLogBreadthChanged" Unchecked="OverviewLogBreadthChanged"/>
                            <CheckBox x:Name="OverviewAtrp" Content="ATRP(1)" IsChecked="True"
                                      Foreground="#6750A4" Margin="0,0,13,0"
                                      Checked="OverviewIndicatorChanged" Unchecked="OverviewIndicatorChanged"/>
                            <CheckBox x:Name="OverviewEma" Content="EMA 20/50/100/200" IsChecked="False"
                                      Checked="OverviewIndicatorChanged" Unchecked="OverviewIndicatorChanged"/>
                        </StackPanel>
                        <Grid x:Name="OverviewFullGrid" Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <local:BreadthChart x:Name="Sp50Chart"/>
                            <local:BreadthChart x:Name="Sp100Chart" Grid.Column="1"/>
                            <local:BreadthChart x:Name="Sp200Chart" Grid.Row="1"/>
                            <local:BreadthChart x:Name="Nasdaq100Chart" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <Grid x:Name="OverviewIndividualGrid" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="OverviewCombinedRow" Height="2*"/>
                                <RowDefinition x:Name="OverviewAtrpSplitterRow" Height="5"/>
                                <RowDefinition x:Name="OverviewAtrpRow" Height="*"/>
                            </Grid.RowDefinitions>
                            <local:BreadthChart x:Name="OverviewCombinedChart" Grid.Row="0"/>
                            <GridSplitter x:Name="OverviewAtrpSplitter" Grid.Row="1" Height="5"
                                          HorizontalAlignment="Stretch" Background="#D7CFBB"
                                          DragCompleted="LayoutSplitterDragCompleted"/>
                            <local:AtrpChart x:Name="OverviewAtrpChart" Grid.Row="2"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="TitanicTab">
                    <TabItem.Header>
                        <TextBlock Text="Titanic" Width="160" TextAlignment="Center"/>
                    </TabItem.Header>
                    <DockPanel Background="White">
                        <StackPanel DockPanel.Dock="Top" Background="White" Orientation="Horizontal" HorizontalAlignment="Center" Margin="6,4,6,0">
                            <CheckBox x:Name="TitanicShowActive" Content="Titanic Active" IsChecked="True"
                                      Foreground="#3199C8" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"
                                      Checked="TitanicLayerVisibilityChanged" Unchecked="TitanicLayerVisibilityChanged"/>
                            <CheckBox x:Name="TitanicShowPersistent" Content="Persistent" IsChecked="True"
                                      Foreground="#218A57" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"
                                      Checked="TitanicLayerVisibilityChanged" Unchecked="TitanicLayerVisibilityChanged"/>
                            <CheckBox x:Name="TitanicShowHold" Content="Оценка" IsChecked="True"
                                      Margin="14,0,0,0" VerticalAlignment="Center"
                                      Checked="HoldVisibilityChanged" Unchecked="HoldVisibilityChanged"/>
                            <CheckBox x:Name="TitanicShowNewHigh" Content="New High" IsChecked="True"
                                      Foreground="#239152" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"
                                      Checked="TitanicLayerVisibilityChanged" Unchecked="TitanicLayerVisibilityChanged"/>
                            <CheckBox x:Name="TitanicShowNewLow" Content="New Low" IsChecked="True"
                                      Foreground="#C43737" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"
                                      Checked="TitanicLayerVisibilityChanged" Unchecked="TitanicLayerVisibilityChanged"/>
                            <CheckBox x:Name="TitanicShowValue" Content="Titanic value" IsChecked="True"
                                      Foreground="#2958B0" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"
                                      Checked="TitanicLayerVisibilityChanged" Unchecked="TitanicLayerVisibilityChanged"/>
                        </StackPanel>
                        <local:TitanicChart x:Name="TitanicChart"/>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="FuzzyTab">
                    <TabItem.Header>
                        <TextBlock Text="Fuzzy map" Width="160" TextAlignment="Center"/>
                    </TabItem.Header>
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FuzzyAnalysisColumn" Width="1*" MinWidth="285"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition x:Name="FuzzyChartColumn" Width="3*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Background="White" Orientation="Horizontal" HorizontalAlignment="Center" Margin="6,4,6,0">
                                <TextBlock Text="Phase:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Border Width="14" Height="14" Background="#188040" Margin="8,0,3,0"/>
                                <TextBlock Text="Strong buy" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#7EBE76" Margin="14,0,3,0"/>
                                <TextBlock Text="Buy" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="White" BorderBrush="#CFC4AB" BorderThickness="1" Margin="14,0,3,0"/>
                                <TextBlock Text="Neutral" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#E68430" Margin="14,0,3,0"/>
                                <TextBlock Text="Sell" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#C43737" Margin="14,0,3,0"/>
                                <TextBlock Text="Strong sell" VerticalAlignment="Center"/>
                                <TextBlock Text="   VIX curve:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Border Width="14" Height="14" Background="#188040" Margin="8,0,3,0"/>
                                <TextBlock Text="STR. contango" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#7EBE76" Margin="8,0,3,0"/>
                                <TextBlock Text="Contango" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#E89737" Margin="8,0,3,0"/>
                                <TextBlock Text="Mixed" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#E78B78" Margin="8,0,3,0"/>
                                <TextBlock Text="Backward" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#C43737" Margin="8,0,3,0"/>
                                <TextBlock Text="STR. backward" VerticalAlignment="Center"/>
                                <TextBlock Text="   SVXY:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Border Width="14" Height="14" Background="#268BC4" Margin="8,0,3,0"/>
                                <TextBlock Text="Strong buy" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#89CBE8" Margin="8,0,3,0"/>
                                <TextBlock Text="Buy / hold" VerticalAlignment="Center"/>
                                <Border Width="14" Height="14" Background="#D3EEF8" Margin="8,0,3,0"/>
                                <TextBlock Text="Extended hold" VerticalAlignment="Center"/>
                                <CheckBox x:Name="FuzzyShowHold" Content="Оценка" IsChecked="True"
                                          Margin="18,0,0,0" VerticalAlignment="Center"
                                          Checked="HoldVisibilityChanged" Unchecked="HoldVisibilityChanged"/>
                        </StackPanel>
                        <Border x:Name="FuzzyAnalysisPanel" Grid.Row="1" Grid.Column="0" Margin="5,4,2,4" Padding="12,10"
                                Background="#F6F9FC" BorderBrush="#C7D3DF" BorderThickness="1"
                                CornerRadius="4">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="CopyMarketStateButton" Grid.Column="0"
                                            Width="25" Height="24" Margin="0,0,7,0" Padding="0"
                                            Background="Transparent" BorderBrush="#AAB8C5"
                                            ToolTip="Скопировать весь отчёт о состоянии рынка"
                                            Click="CopyMarketStateClick">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="#25303D"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="Состояние рынка"
                                               FontSize="15" FontWeight="SemiBold" Foreground="#25303D"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                        <TextBlock Text="Модель:" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#25303D" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="PositionProfile" Width="92" Height="24" Margin="6,0,0,0"
                                                  SelectedIndex="1" SelectionChanged="PositionProfileChanged">
                                            <ComboBoxItem Content="Soft"/>
                                            <ComboBoxItem Content="Standard"/>
                                            <ComboBoxItem Content="Hard"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer x:Name="FuzzyAnalysisScroll" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Border x:Name="OperationalPositionBorder"
                                                Margin="0,0,0,9" Padding="9,7"
                                                Background="#FFFFFF" BorderBrush="#B9C8D5"
                                                BorderThickness="1" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock x:Name="OperationalPositionTitle"
                                                           Text="ПОЗИЦИЯ ПО МОДЕЛИ"
                                                           FontSize="12.5" FontWeight="Bold"
                                                           Foreground="#25303D" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="OperationalEventWarning"
                                                           Text="" Visibility="Collapsed"
                                                           TextWrapping="Wrap" FontSize="12" FontWeight="Bold"
                                                           LineHeight="17" Foreground="#C62828" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="OperationalVixExpirationNotice"
                                                           Text="" Visibility="Collapsed"
                                                           TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                                                           LineHeight="17" Foreground="#315A7D" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="OperationalPositionText"
                                                           Text="Ожидание расчёта"
                                                           TextWrapping="Wrap" FontSize="12"
                                                           LineHeight="17" Foreground="#303840"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="FuzzyAnalysisText"
                                                   Text="Рассчитайте данные, затем наведите курсор на график."
                                                   TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                                                   Foreground="#303840"/>
                                        <Border x:Name="TopContributionsBorder" Margin="0,10,0,0" Padding="9,7"
                                                Background="#FFFFFF" BorderBrush="#B9C8D5"
                                                BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock x:Name="TopContributionsTitle"
                                                           Text="ТОП-10 ПОКАЗАТЕЛЕЙ"
                                                           TextWrapping="Wrap"
                                                           FontSize="12.5" FontWeight="Bold"
                                                           Foreground="#25303D" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="TopContributionsText"
                                                           TextWrapping="Wrap" FontSize="12"
                                                           LineHeight="17" Foreground="#303840"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <GridSplitter x:Name="FuzzyHorizontalSplitter" Grid.Row="1" Grid.Column="1"
                                      Width="5" HorizontalAlignment="Stretch"
                                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                      Background="#D7CFBB"
                                      DragCompleted="LayoutSplitterDragCompleted"/>
                        <local:FuzzyStateChart x:Name="FuzzyChart" Grid.Row="1" Grid.Column="2"/>
                    </Grid>
                </TabItem>
                <TabItem x:Name="TradingEnsemblesTab">
                    <TabItem.Header>
                        <TextBlock Text="Trading Ensemble" Width="160" TextAlignment="Center"/>
                    </TabItem.Header>
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" BorderBrush="#D7CFBB" BorderThickness="0,0,0,1" Padding="10,5,8,5">
                          <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="Рабочая директория:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Grid Width="180" Height="24" Margin="0,0,18,0">
                                <TextBox x:Name="TradingEnsembleDirectory" Text="D:\TorchSharp4GPU" IsReadOnly="True"
                                         Padding="4,2,28,2" VerticalContentAlignment="Center"/>
                                <Button x:Name="TradingDirectoryButton" Content="▼" Width="25" Height="22"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        ToolTip="Выбрать рабочую директорию"
                                        Click="OpenTradingDirectoryTreeClick"/>
                                <Popup x:Name="TradingDirectoryPopup" Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=TradingEnsembleDirectory}"
                                       StaysOpen="False" AllowsTransparency="True">
                                    <Border Width="430" Height="420" Background="White" BorderBrush="#8A8170"
                                            BorderThickness="1" CornerRadius="2" Padding="8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Выберите рабочую директорию"
                                                       FontWeight="SemiBold" Margin="2,0,2,7"/>
                                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" Margin="0,8,0,0">
                                                <Button Content="Выбрать" Width="88" Height="25" Margin="0,0,7,0"
                                                        Click="SelectTradingDirectoryClick"/>
                                                <Button Content="Закрыть" Width="78" Height="25"
                                                        Click="CloseTradingDirectoryTreeClick"/>
                                            </StackPanel>
                                            <Border BorderBrush="#D7CFBB" BorderThickness="1" Background="White">
                                                <TreeView x:Name="TradingDirectoryTree"
                                                          MouseDoubleClick="TradingDirectoryTreeMouseDoubleClick"/>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <CheckBox x:Name="TradingShowSp500" Content="S&amp;P 500" IsChecked="True" Margin="0,0,16,0"
                                      VerticalAlignment="Center" Checked="TradingEnsembleOptionsChanged" Unchecked="TradingEnsembleOptionsChanged"/>
                            <CheckBox x:Name="TradingShowZz1" Content="ZZ1" IsChecked="True" Margin="0,0,14,0"
                                      VerticalAlignment="Center" Checked="TradingEnsembleOptionsChanged" Unchecked="TradingEnsembleOptionsChanged"/>
                            <CheckBox x:Name="TradingShowZz2" Content="ZZ2" IsChecked="True" Margin="0,0,14,0"
                                      VerticalAlignment="Center" Checked="TradingEnsembleOptionsChanged" Unchecked="TradingEnsembleOptionsChanged"/>
                            <CheckBox x:Name="TradingShowZz3" Content="ZZ3" IsChecked="True" Margin="0,0,18,0"
                                      VerticalAlignment="Center" Checked="TradingEnsembleOptionsChanged" Unchecked="TradingEnsembleOptionsChanged"/>
                            <TextBlock Text="Forecast" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Button Content="−" Width="23" Height="22" Padding="0" Click="DecreaseTradingForecastClick"/>
                            <TextBox x:Name="TradingForecastValue" Text="10" Width="34" Height="22" Margin="3,0"
                                     IsReadOnly="True" TextAlignment="Center" VerticalContentAlignment="Center"/>
                            <Button Content="+" Width="23" Height="22" Padding="0" Margin="0,0,10,0"
                                    Click="IncreaseTradingForecastClick"/>
                            <TextBlock x:Name="TradingCalculationStatus" Text="Forecast: ожидание данных"
                                       MinWidth="190" Margin="0,0,18,0" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="#B56700" TextTrimming="CharacterEllipsis"/>
                            <CheckBox x:Name="TradingShowEma" Content="EMA 20/50/100/200" IsChecked="False"
                                      VerticalAlignment="Center" Checked="TradingEnsembleOptionsChanged" Unchecked="TradingEnsembleOptionsChanged"/>
                            <CheckBox x:Name="TradingShowScoring" Content="Scoring classification" IsChecked="False"
                                      Margin="28,0,0,0" VerticalAlignment="Center"
                                      Checked="TradingEnsembleOptionsChanged" Unchecked="TradingEnsembleOptionsChanged"/>
                          </WrapPanel>
                        </Border>
                        <local:TradingEnsembleChart x:Name="TradingEnsembleChart" Grid.Row="1"/>
                    </Grid>
                </TabItem>
                <TabItem x:Name="ZweigTab">
                    <TabItem.Header>
                        <TextBlock Text="Zweig" Width="160" TextAlignment="Center"/>
                    </TabItem.Header>
                    <DockPanel Background="White">
                        <StackPanel DockPanel.Dock="Top" Background="White" Orientation="Horizontal" HorizontalAlignment="Center" Margin="6,4,6,0">
                            <TextBlock Text="Strong 60 / 11 / 21" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <CheckBox x:Name="UseWorkingZweig" Margin="18,0,0,0" VerticalAlignment="Center"
                                      Content="Working mode 60 / 13 / 15"
                                      Checked="ZweigModeChanged" Unchecked="ZweigModeChanged"/>
                            <TextBlock x:Name="ZweigModeText" Margin="18,0,0,0" VerticalAlignment="Center"
                                       Text="Current: Strong" Foreground="#087443" FontWeight="SemiBold"/>
                            <CheckBox x:Name="ZweigShowHold" Content="Оценка" IsChecked="True"
                                      Margin="18,0,0,0" VerticalAlignment="Center"
                                      Checked="HoldVisibilityChanged" Unchecked="HoldVisibilityChanged"/>
                        </StackPanel>
                        <local:ZweigChart x:Name="ZweigChart"/>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="ContangoTab">
                    <TabItem.Header>
                        <TextBlock Text="Contango" Width="160" TextAlignment="Center"/>
                    </TabItem.Header>
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="ContangoTopRow" Height="2*"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition x:Name="ContangoBottomRow" Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ContangoLeftColumn" Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition x:Name="ContangoRightColumn" Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                                    HorizontalAlignment="Left" Margin="10,3,4,3">
                                <CheckBox x:Name="ContangoShowVix" Content="VIX (left scale)" IsChecked="False"
                                          Foreground="#5C4C99" FontWeight="SemiBold" VerticalAlignment="Center"
                                          Margin="0,0,16,0"
                                          Checked="ContangoShowVixChanged" Unchecked="ContangoShowVixChanged"/>
                                <TextBlock Text="VIX curve:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Border Width="12" Height="12" Background="#188040" Margin="8,0,2,0"/>
                                <TextBlock Text="Strong contango" VerticalAlignment="Center" FontSize="11"/>
