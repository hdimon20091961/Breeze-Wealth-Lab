<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Breeze</AssemblyName>
    <RootNamespace>BreezeVL</RootNamespace>
    <Version>0.11.8</Version>
    <DefineConstants>$(DefineConstants);EVENT_MODEL_TEST;RULES2_ENGINE_ONLY</DefineConstants>
    <WealthLabInstallDir Condition="'$(WealthLabInstallDir)' == ''">C:\Program Files\Quantacula, LLC\WealthLab 8</WealthLabInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="WealthLab.Core">
      <HintPath>$(WealthLabInstallDir)\WealthLab.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WealthLab.WPF">
      <HintPath>$(WealthLabInstallDir)\WealthLab.WPF.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WealthLab.TASC">
      <HintPath>$(WealthLabInstallDir)\WealthLab.TASC.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WealthLab.AdvancedSmoothers">
      <HintPath>$(WealthLabInstallDir)\WealthLab.AdvancedSmoothers.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WealthLab.DataExtensions">
      <HintPath>$(WealthLabInstallDir)\WealthLab.DataExtensions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Indicators.JohnEhlers_8Wealth">
      <HintPath>$(WealthLabInstallDir)\Indicators.JohnEhlers_8Wealth.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TorchSharp">
      <HintPath>$(WealthLabInstallDir)\TorchSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="encog-core-cs">
      <HintPath>$(WealthLabInstallDir)\encog-core-cs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="BreezeHelp.html" />
    <None Include="BreezeHelp.standalone.html"
          Link="BreezeHelp.html"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('BreezeHelp.standalone.html')" />
    <EmbeddedResource Include="BreezeRules.json" />
    <EmbeddedResource Include="BreezeEventCatalog.json" />
    <None Update="BreezeEventCatalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="BreezeRules.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- The DLL and the standalone Wealth-Lab strategy compile the same
         75-event model. EVENT_MODEL_TEST excludes only the strategy shell. -->
    <Compile Include="../Breeze.Strategies/BreezeHoldPositionStrategy_new.cs"
             Link="Research/BreezeHoldPositionEventModel.cs" />
    <Compile Include="../Rules2ResearchStrategy.cs" Link="Research/Rules2Engine.cs" />
  </ItemGroup>
</Project>
