<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Breeze</AssemblyName>
    <RootNamespace>BreezeVL</RootNamespace>
    <Version>0.1.0</Version>
    <WealthLabInstallDir>C:\Program Files\Quantacula, LLC\WealthLab 8</WealthLabInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="WealthLab.Core">
      <HintPath>$(WealthLabInstallDir)\WealthLab.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WealthLab.WPF">
      <HintPath>$(WealthLabInstallDir)\WealthLab.WPF.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
